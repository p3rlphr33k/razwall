<TMPL_VAR NAME="NW_VAL_title">

<h2>Step <TMPL_VAR NAME="NW_VAL_step">/8: Create network zones</h2>

<section class="current-zones">
  <h3>Current Zones</h3>
  <div class="zones-header">
    <span class="zone-col header">Zone</span>
    <span class="desc-col header">Description</span>
    <span class="type-col header">Type</span>
    <span class="iface-col header">Interface</span>
	<span class="iface-col header">Delete</span>
  </div>
  <TMPL_LOOP NAME="zones">
    <div class="zones-row">
      <span class="zone-col">
        <span id="zoneLabel_<TMPL_VAR NAME='name' ESCAPE='HTML'>"
              class="zone-name"
              style="color:<TMPL_VAR NAME='color' ESCAPE='HTML'>">
          <b><TMPL_VAR NAME='name' ESCAPE='HTML'></b>
        </span>
      </span>
      <span class="desc-col"><TMPL_VAR NAME='desc' ESCAPE='HTML'></span>
      <span class="type-col"><TMPL_VAR NAME='type' ESCAPE='HTML'></span>
      <span class="iface-col"><TMPL_VAR NAME='iface' ESCAPE='HTML'></span>
	  <span class="iface-col"><img src="/images/close_16.png" onClick="alert('<TMPL_VAR NAME='name' ESCAPE='HTML'>');"></span>
    </div>
  </TMPL_LOOP>

  <hr>
  <div class="ifaces-summary">Physical Interfaces: <TMPL_VAR NAME='NW_VAL_if_count'></div>
  <hr>
</section>

<form action="/cgi-bin/razwall-addZone.pl" method="post" id="zonesForm">
  <section class="new-zones">
    <h3>New Zone:</h3>
    <div id="newZonesContainer">
      <div class="zone-input-row" data-index="0">
        <input type="text" name="ZSTRING" placeholder="zone name" required>
        <input type="text" name="ZDESC" placeholder="zone description">
        <select name="ZTYPE">
          <option>LAN</option>
          <option>WAN</option>
          <option>VPN</option>
          <option value="">unassigned</option>
        </select>
        <input type="color" name="ZCOLOR" id="zoneColor" class="zone-color-picker" value="#ffffff">
      </div>
    </div>
    <button type="button" id="addZoneBtn" class="btn add-zone">+ Add Zone</button>
  </section>
  </form>

<form action="" method="post">
  <div class="form-actions">
	<input type="hidden" name="session_id" value="<TMPL_VAR NAME=NW_VAL_session_id>">
	<input type="hidden" name="step" value="<TMPL_VAR NAME=NW_VAL_step>">
    <button type="submit" name="prev" class="btn"><< Prev</button>
    <button type="submit" name="cancel" class="btn">Cancel</button>
    <button type="submit" name="next" class="btn">Next >></button>
  </div>
</form>




