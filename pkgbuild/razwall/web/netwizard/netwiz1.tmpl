<br style="clear:both">

<TMPL_LOOP NAME=NW_VAL_NETWORK_LOOP>

<!-- HIDEABLE DIV -->
<div class="wan_types <TMPL_VAR NAME=NETWORK_LOOP_NAME>" style="display: none;">

    <!-- Fieldset: Network Mode -->
    <fieldset class="incoming">

<TMPL_IF EXPR="NETWORK_LOOP_WAN_ITEM eq ''">
