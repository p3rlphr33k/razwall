<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>RazWall Firewall</title>

<link rel="shortcut icon" href="/favicon.ico" />
